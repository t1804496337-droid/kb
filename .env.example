# Required. Login rejects when either value is missing (fail closed).
# Set these in the environment — Vercel project `kb` for production.
# The password lives only in Vercel env / Tang's memory. Do not commit it.
SITE_AUTH_USER=
SITE_AUTH_PASS=

# Optional aliases already read by src/app/api/auth/login/route.ts
# when SITE_AUTH_* is unset. Prefer SITE_AUTH_*. NEXT_PUBLIC_* can
# be exposed to the browser — do not put the password in them.
# NEXT_PUBLIC_STUDIO_USER=
# NEXT_PUBLIC_STUDIO_PASS=

# Local preview: skip the middleware login wall. The studio login API
# still requires SITE_AUTH_USER and SITE_AUTH_PASS.
# SITE_AUTH_OFF=1
